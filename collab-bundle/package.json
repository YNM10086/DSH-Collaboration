{
  "name": "dsh-collab-bundle",
  "version": "0.1.0",
  "description": "DSH 多窗口协作 bundle：共享任务板、文件认领锁（排队接管）、写入拦截（tools/pre-execute）、审计日志、用户指定身份。装进 profile 后所有窗口自动获得 collab 工具，宿主重启自动恢复。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.2.0"
  },
  "license": "Apache-2.0"
}
